----
1

# --- logical operators ---
query I
SELECT 1 AND 1;
----
1

query I
SELECT 1 AND 0;
----
0

query I
SELECT NULL AND 0;
----
0

query I
SELECT NULL AND 1;
----
NULL

query I
SELECT NULL AND NULL;
----
NULL

query I
SELECT 1 OR 0;
----
1

query I
SELECT NULL OR 1;
----
1

query I
SELECT NULL OR 0;
----
NULL

query I
SELECT NOT 1;
----
0

query I
