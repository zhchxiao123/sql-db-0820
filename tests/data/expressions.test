# --- CASE WHEN ---
query I
SELECT CASE WHEN 1 THEN 2 ELSE 3 END;
----
2

query I
SELECT CASE WHEN 0 THEN 1 ELSE 2 END;
----
2

query I
SELECT CASE WHEN NULL THEN 1 ELSE 2 END;
----
2

query I
SELECT CASE WHEN 0 THEN 1 END;
----
NULL

query I
SELECT CASE WHEN 1 THEN 2 WHEN 1 THEN 3 END;
----
2

query T
SELECT CASE 2 WHEN 1 THEN 'a' WHEN 2 THEN 'b' END;
----
b

query I
SELECT CASE NULL WHEN NULL THEN 1 ELSE 0 END;
----
0

query I
SELECT CASE WHEN 2>1 THEN 10 ELSE 20 END;
----
10

# --- multi-column / multi-expression ---
query II
SELECT 1, 2;
----
1
2

query IT
SELECT 1+1, 'x';
----
2
x

# --- statement ok / error records ---
statement ok
SELECT 1;

statement error
SELECT 1 +;

statement error
SELECT * FROM t;

statement error
CREATE TABLE t1(x);

statement ok
SELECT 'a', 1+1, NULL;
