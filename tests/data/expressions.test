# Expression SELECT corpus (no FROM clause) — a2 acceptance data.
# Plaintext expectations, one value per line, NULL rendered as NULL.

# --- literals ---
query I
SELECT 1;
----
1

query I
SELECT -42;
----
-42

query R
SELECT 3.5;
----
3.5

query R
SELECT 3.0;
----
3.0

query T
SELECT 'hello';
----
hello

query T
SELECT 'it''s';
----
it's

query I
SELECT NULL;
----
NULL

query I
SELECT TRUE;
----
1

query I
SELECT FALSE;
----
0

# --- arithmetic and parentheses ---
query I
SELECT 1+2*3;
----
7

query I
SELECT (1+2)*3;
----
9

query I
SELECT 2*3+1;
----
7

query I
SELECT 10-4-3;
----
3

query I
SELECT 7/2;
----
3

query I
SELECT -7/2;
----
-3

query R
SELECT 7.0/2;
----
3.5

query I
SELECT 7%3;
----
1

query I
SELECT -7%3;
----
-1

query I
SELECT 1/0;
----
NULL

query I
SELECT -5+3;
----
-2

query R
SELECT 0.1+0.2;
----
0.3

query I
SELECT 2*3;
----
6

