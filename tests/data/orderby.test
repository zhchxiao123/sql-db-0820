# ORDER BY — a1 acceptance data (select3.test style).
# NULL sorts smallest (ASC first, DESC last); multi-column lexicographic
# with per-column ASC/DESC; expressions and ordinals supported.

statement ok
CREATE TABLE t(a INTEGER, b TEXT);

statement ok
INSERT INTO t VALUES (3, 'c'), (1, 'a'), (NULL, 'n'), (2, 'b'), (3, 'C'), (1, 'A');

query I
SELECT a FROM t ORDER BY a;
----
NULL
1
1
2
3
3

query I
SELECT a FROM t ORDER BY a DESC;
----
3
3
2
1
1
NULL

query IT
SELECT a, b FROM t ORDER BY a, b;
----
